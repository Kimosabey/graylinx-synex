# Synex — what never enters the repository.
#
# This file was missing entirely until 2026-08-14, and `backend/.env` was checked as *not
# ignored* moments before a database password was about to be written into it. The repo is
# published to GitHub, so that would have pushed a live credential. Secrets first, therefore,
# and everything else after.

# ── secrets ─────────────────────────────────────────────────────────────────────
# `.env.example` is deliberately NOT ignored: it carries the shape and the reasons, and it
# holds no values. Everything that holds a value is ignored.
.env
.env.*
!.env.example
*.pem
*.key
!**/*.key.example
secrets/
infra/sql/*-local.sql

# ── database backups ────────────────────────────────────────────────────────────
# A pre-migration dump of `graylinx_synex` is ~2 GB and is the rollback path, so it must
# exist on disk and must never enter git. Added 2026-08-17 when the v2 re-clone was run.
backups/
*.sql.gz

# ── Python ──────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node and Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
playwright-report/
test-results/

# ── build output ────────────────────────────────────────────────────────────────
# `site/` is generated by build_site.sh for Netlify; the sources are tracked, the build is
# not. Keeping it out is also what stops docs/00-source/ reaching the internet.
site/
dist/
build/

# ── local noise ─────────────────────────────────────────────────────────────────
.netlify/
_inbox/
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
!.vscode/extensions.json

# ── model transcripts are TRACKED, deliberately ─────────────────────────────────
# `SYNEX_MODEL_MODE=stub` replays committed transcripts, which is what lets most of the
# build happen with the box terminated. They are evidence of what a model actually said, so
# they belong in git — listed here as a note, not as an exclusion.
