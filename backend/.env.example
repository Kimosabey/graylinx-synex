# Synex back end — copy to .env and fill the blanks.
#
# The dividing rule: if a value has a REASON it lives in app/config.py with the reason in a
# comment above it. If it has a SECRET or an ADDRESS it lives here. That is why this file is
# short and config.py will not be — the reasons are the most valuable prose in the codebase
# and they cannot live in a .env.
#
# Ports were checked against what is actually listening on the development machine, not
# assumed. Thermynx occupies 5442, 6380, 8000 and 5173, and 3000-3003 are taken — which is why
# the front end is on 3100 rather than the Next.js default.

# ── the plant: MySQL, shared with the existing platform, READ-ONLY ──────────────
# Port 3307, not 3306 — the service is MySQL80_1.
# Create this user before first run; see infra/sql/01-mysql-grants.sql. Q42: the back end must
# not connect as root. A SELECT-only grant makes "Synex never writes to the plant" a property
# of the database rather than a sentence in a document.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=synex_plant_ro
MYSQL_PASSWORD=
MYSQL_DB=graylinx_synex

# ── Synex's own state: PostgreSQL + pgvector ────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://synex:dev@127.0.0.1:5443/synex

# ── the queue that RC17 schedules on ───────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6381/0

# ── inference: Ollama on the rented box, shared. Never a hosted API. ───────────
OLLAMA_HOST=http://127.0.0.1:11500
OLLAMA_BOX_LABEL=Jarvis

# ── identity. D-013: a persona switcher, no authentication, for the demonstration. ─
# dev_jwt | signed_header | oidc — the last two stay open until Q41 is answered.
AUTH_MODE=dev_jwt
JWT_SECRET=

# Stamped on every audit row (G3).
POLICY_VERSION=2026-08-13.1

# ── the window discipline, config-enforced rather than a literal in a query ─────
# Real readings stop here; everything after is simulated, and the simulation invented
# cond_flow. D-009: a demonstration runs on the measured window.
SYNEX_MEASURED_WINDOW_END=2026-06-23T11:50:00

# ── how the models are reached while building ──────────────────────────────────
# stub   no GPU at all — the default, so most of the build happens with the box terminated
# record capture real completions into committed transcripts
# live   the box
SYNEX_MODEL_MODE=stub

BACKEND_PORT=8001
LOG_JSON=true
